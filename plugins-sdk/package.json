{
  "name": "@repogo/plugins",
  "version": "0.1.24",
  "description": "Write RepoGo plugins: collections and methods over SQLite that agents and cards call",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/testing.ts --target=bun --outdir dist --splitting --external zod && tsc -p tsconfig.build.json",
    "build:runtime": "bun build src/run.ts src/worker.ts --target=bun --outdir ../internal/plugins/runtime",
    "prepack": "cp ../LICENSE.md LICENSE.md && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "license": "FSL-1.1-ALv2",
  "homepage": "https://repogo.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repogoapp/host.git",
    "directory": "plugins-sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
